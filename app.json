{
  "expo": {
    "name": "Stock Report",
    "slug": "stock-report",
    "scheme": "stockreport",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "platforms": ["ios", "android", "web"],
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-document-picker",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Stock Report to scan product barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sqlite"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.codex.stockreport"
    },
    "android": {
      "package": "com.codex.stockreport",
      "adaptiveIcon": {
        "backgroundColor": "#f7f7f4"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    }
  }
}