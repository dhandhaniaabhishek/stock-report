{
  "name": "stock-report",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "doctor": "expo-doctor",
    "eas:init": "npx eas-cli@latest init",
    "eas:build:android": "npx eas-cli@latest build -p android --profile production",
    "eas:build:ios": "npx eas-cli@latest build -p ios --profile production",
    "eas:deploy:web": "expo export -p web && npx eas-cli@latest deploy --prod"
  },
  "dependencies": {
    "expo": "~56.0.0",
    "expo-camera": "~56.0.7",
    "expo-document-picker": "~56.0.4",
    "expo-file-system": "~56.0.7",
    "expo-router": "~56.2.9",
    "expo-sqlite": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~5.9.0"
  }
}
